# Spark Control gateway — environment (NAMES ONLY; copy to .env and fill in).
# Never commit .env.
SPARKCTL_TOKEN=change-me-long-random-string

# Bind address (LAN/tailnet interface; 0.0.0.0 = all)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001

# Job ledger (persists start/stop history)
SPARKCTL_JOB_STORE=/home/YOUR_USER/spark-control/sparkctl-jobs.sqlite3

# Optional: path to your recipes config (defaults to config/recipes.toml next to the code)
# SPARKCTL_RECIPES=/home/YOUR_USER/spark-control/config/recipes.toml

# Optional: default recipe shown on the Status page (default: first recipe in config)
# SPARKCTL_DEFAULT_RECIPE=my-server

# Optional: monitor tiles on the Monitor page (leave empty to hide a tile)
# sparkDash-style live glance (e.g. your node's tailnet IP or LAN IP):
MONITOR_SPARKDASH_URL=
# Grafana/Prometheus dashboard (opens in a new tab):
MONITOR_GRAFANA_URL=
